          "431": { "$ref": "#/components/responses/SimpleError" },
          "500": { "$ref": "#/components/responses/StateResponse" },
          "429": { "$ref": "#/components/responses/RateLimited" }, "503": { "$ref": "#/components/responses/StateError" }
        }
      }
    },
    "/api/demonstrate/{attackName}": {
      "post": {
        "operationId": "demonstrateBindingAttack",
        "tags": ["simulator"], "security": [{}, { "sessionCookie": [] }], "x-simulator-only": true, "x-maxBodyBytes": 16384,
        "requestBody": { "$ref": "#/components/requestBodies/OptionalObject" },
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/SecFetchSite" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          {
            "name": "attackName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "altered-amount",
                "altered-merchant",
                "modified-nonce",
                "wrong-device",
                "wrong-key",
                "expired-challenge",
                "reused-signature"
              ]
            }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/StateResponse" }, "400": { "$ref": "#/components/responses/SimpleError" },
          "401": { "$ref": "#/components/responses/SimpleError" }, "403": { "$ref": "#/components/responses/SimpleError" }, "409": { "$ref": "#/components/responses/ConflictError" },
          "413": { "$ref": "#/components/responses/SimpleError" }, "415": { "$ref": "#/components/responses/SimpleError" },
          "428": { "$ref": "#/components/responses/SimpleError" }, "431": { "$ref": "#/components/responses/SimpleError" },
          "429": { "$ref": "#/components/responses/RateLimited" }, "503": { "$ref": "#/components/responses/StateError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "loginBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Provider profile: opaque controlled-demo credential or OIDC JWT access token"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "airlock_session"
      }
    },
    "requestBodies": {
      "OptionalObject": {
        "required": false,
        "description": "No body is needed. If supplied, it must be a JSON object; ignored properties are accepted by the current lab.",
        "content": {
          "application/json": {
            "schema": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "parameters": {
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": false,
        "description": "When present, must be a serialized HTTP origin exactly matching `http://` plus the Host header. Absence preserves CLI/harness use.",
        "schema": { "type": "string", "format": "uri" }
      },
      "SecFetchSite": {
        "name": "Sec-Fetch-Site",
        "in": "header",
        "required": false,
        "description": "When present on a mutation, only same-origin or none is accepted.",
        "schema": { "type": "string", "enum": ["same-origin", "none"] }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Optional in ephemeral mode and required when AIRLOCK_DB_PATH enables persistence. The key is scoped to canonical method, path/query, and JSON body; reuse with different input returns 409.",
        "x-requiredWhen": "AIRLOCK_DB_PATH is set",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "CsrfToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "description": "Per-session unpredictable CSRF token returned only by login.",
        "schema": { "type": "string", "minLength": 32, "maxLength": 128 }
      }
    },
    "responses": {
      "StateResponse": {
        "description": "Current public simulator state",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/PublicState" }
          }
        }
      },
      "SimpleError": {
        "description": "Request rejected before a stateful lab operation completed",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SimpleError" }
          }
        }
      },
      "ConflictError": {
        "description": "Either a request-level idempotency conflict or a state conflict with authoritative public state",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                { "$ref": "#/components/schemas/SimpleError" },
                { "$ref": "#/components/schemas/StateError" }
              ]
            }
          }
        }
      },
      "StateError": {
        "description": "Service admission rejection, state conflict, or persistence failure",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                { "$ref": "#/components/schemas/SimpleError" },
                { "$ref": "#/components/schemas/StateError" }
              ]
            }
          }
        }
      },
      "RateLimited": {
        "description": "Per-client mutation rate limit exceeded (SIMULATOR: in-process single-instance limiter; distributed/edge enforcement is external). No state mutation occurred.",
        "headers": {
          "Retry-After": {
            "description": "Whole seconds the client should wait before retrying.",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SimpleError" }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Process-local request or SSE admission is saturated. No request body was read and no state mutation occurred.",
        "headers": {
          "Retry-After": {
            "description": "Whole seconds the client should wait before retrying.",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SimpleError" }
          }
        }
      }
    },
    "schemas": {
      "Principal": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principalId", "tenantId", "roles"],
        "properties": {
          "principalId": { "type": "string", "minLength": 1 },
          "tenantId": { "type": "string", "minLength": 1 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "SessionLogin": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal", "csrfToken", "expiresAt"],
        "properties": {
          "principal": { "$ref": "#/components/schemas/Principal" },
          "csrfToken": { "type": "string", "minLength": 32 },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "SessionCurrent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal", "expiresAt"],
        "properties": {
          "principal": { "$ref": "#/components/schemas/Principal" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok", "simulator", "buildId", "staticAssetDigest", "service"],
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "simulator": { "type": "boolean", "const": true },
          "buildId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "staticAssetDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "service": { "$ref": "#/components/schemas/ServiceMetrics" }
        }
      },
      "ServiceMetrics": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "windowStartedAt", "generatedAt", "counters", "latencyMilliseconds", "saturation", "readiness", "sampleCounts"],
        "properties": {
          "schemaVersion": { "type": "string", "const": "airlock.service-metrics.v1" },
          "windowStartedAt": { "type": "string", "format": "date-time" },
          "generatedAt": { "type": "string", "format": "date-time" },
          "counters": {
            "type": "object", "additionalProperties": false,
            "required": ["requestsTotal", "successfulRequestsTotal", "clientErrorsTotal", "serverErrorsTotal", "overloadRejectionsTotal", "dependencyFailuresTotal"],
            "properties": {
              "requestsTotal": { "$ref": "#/components/schemas/MetricCounter" },
              "successfulRequestsTotal": { "$ref": "#/components/schemas/MetricCounter" },
              "clientErrorsTotal": { "$ref": "#/components/schemas/MetricCounter" },
              "serverErrorsTotal": { "$ref": "#/components/schemas/MetricCounter" },
              "overloadRejectionsTotal": { "$ref": "#/components/schemas/MetricCounter" },
              "dependencyFailuresTotal": { "$ref": "#/components/schemas/MetricCounter" }
            }
          },
          "latencyMilliseconds": {
            "type": "object", "additionalProperties": false,
            "required": ["readP95", "mutationP95"],
            "properties": {
              "readP95": { "$ref": "#/components/schemas/MetricDuration" },
              "mutationP95": { "$ref": "#/components/schemas/MetricDuration" }
            }
          },
          "saturation": {
            "type": "object", "additionalProperties": false,
            "required": ["currentRequests", "peakRequests", "currentSseStreams", "peakSseStreams"],
            "properties": {
              "currentRequests": { "$ref": "#/components/schemas/MetricCounter" },
              "peakRequests": { "$ref": "#/components/schemas/MetricCounter" },
              "currentSseStreams": { "$ref": "#/components/schemas/MetricCounter" },
              "peakSseStreams": { "$ref": "#/components/schemas/MetricCounter" }
            }
          },
          "readiness": {
            "type": "object", "additionalProperties": false,
            "required": ["ready", "database", "identityProvider", "auditCustody", "partnerTransport"],
            "properties": {
              "ready": { "type": "boolean" },
              "database": { "type": "boolean" },
              "identityProvider": { "type": "boolean" },
              "auditCustody": { "type": "boolean" },
              "partnerTransport": { "type": "boolean" }
            }
          },
          "sampleCounts": {
            "type": "object", "additionalProperties": false,
            "required": ["readLatency", "mutationLatency"],
            "properties": {
              "readLatency": { "type": "integer", "minimum": 0, "maximum": 2048 },
              "mutationLatency": { "type": "integer", "minimum": 0, "maximum": 2048 }
            }
          }
        }
      },
      "MetricCounter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "MetricDuration": { "type": "number", "minimum": 0, "maximum": 3600000 },
      "SimpleError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "error"],
        "properties": {
          "code": { "$ref": "#/components/schemas/ReasonCode" },
          "error": { "type": "string", "minLength": 1 }
        }
      },
      "StateError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "error", "state"],
        "properties": {
          "code": { "$ref": "#/components/schemas/ReasonCode" },
          "error": { "type": "string", "minLength": 1 },
          "state": { "$ref": "#/components/schemas/PublicState" }
        }
      },
      "TransactionRequest": {
        "type": "object",
        "additionalProperties": true,
        "required": ["amount", "merchantId"],
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^\\s*(?:0\\.(?:[1-9]|[0-9][1-9]|[1-9][0-9])|(?:[1-9][0-9]{0,12}|[1-8][0-9]{13}|900[0-6][0-9]{10}|90070[0-9]{9}|90071[0-8][0-9]{8}|900719[0-8][0-9]{7}|9007199[0-1][0-9]{6}|90071992[0-4][0-9]{5}|900719925[0-3][0-9]{4}|9007199254[0-6][0-9]{3}|90071992547[0-3][0-9]{2}|9007199254740[0-7]|90071992547408)(?:\\.[0-9]{1,2})?|90071992547409(?:\\.(?:[0-8]?[0-9]|9[01]))?)\\s*$",
            "description": "After ECMAScript trim, a positive decimal major-unit amount with at most two fractional digits whose minor-unit value is at most 9007199254740991."
          },
          "merchantId": {
            "type": "string",
            "pattern": "^\\s*[A-Za-z0-9][A-Za-z0-9._:-]{0,63}\\s*$",
            "description": "After ECMAScript trim, 1–64 characters in the documented ASCII identifier set."
          }
        }
      },
      "TrustedDevice": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deviceId", "subjectId", "keyId", "status"],
        "properties": {
          "deviceId": { "type": "string" },
          "subjectId": { "type": "string" },
          "keyId": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "revoked"] }
        }
      },
      "PaymentToken": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tokenId", "subjectId", "accountId", "state"],
        "properties": {
          "tokenId": { "type": "string" },
          "subjectId": { "type": "string" },
          "accountId": { "type": "string" },
          "state": { "type": "string", "enum": ["pending", "active_capped", "active_full", "declined"] },
          "perTransactionCapMinor": { "type": "integer", "minimum": 1 },
          "dailyCapMinor": { "type": "integer", "minimum": 1 }
        }
      },
      "ChallengeBinding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion", "purpose", "challengeId", "subjectId", "accountId",
          "paymentTokenId", "trustedDeviceId", "issuedAt", "expiresAt", "audience"
        ],
        "properties": {
          "protocolVersion": { "type": "string", "const": "airlock.v1" },
          "purpose": { "type": "string", "enum": ["provision-payment-token", "confirm-transaction"] },
          "challengeId": { "type": "string" },
          "subjectId": { "type": "string" },
          "accountId": { "type": "string" },
          "paymentTokenId": { "type": "string" },
          "trustedDeviceId": { "type": "string" },
          "transactionId": { "type": "string" },
          "merchantId": { "type": "string" },
          "amountMinor": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "currency": { "type": "string", "enum": ["USD", "EUR", "GBP", "CAD", "AUD"] },
          "issuedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "audience": { "type": "string", "const": "airlock-issuer" }
        }
      },
      "ProvisioningRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "tokenId", "trustedDeviceId", "state", "challenge"],
        "properties": {
          "requestId": { "type": "string" },
          "tokenId": { "type": "string" },
          "trustedDeviceId": { "type": "string" },
          "state": {
            "type": "string",
            "enum": [
              "requested", "risk_scored", "trusted_device_challenge", "approved",
              "token_active_capped", "token_active_full", "declined", "expired"
            ]
          },
          "challenge": { "$ref": "#/components/schemas/ChallengeBinding" }
        }
      },
      "Transaction": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transactionId", "tokenId", "merchantId", "amountMinor", "currency", "state", "strategy"],
        "properties": {
          "transactionId": { "type": "string" },
          "tokenId": { "type": "string" },
          "merchantId": { "type": "string" },
          "amountMinor": { "type": "integer", "minimum": 1 },
          "currency": { "type": "string", "const": "USD" },
          "state": {
            "type": "string",
            "enum": [
              "received", "confirmation_pending", "confirmed", "declined", "expired",
              "reversal_requested", "reversed", "clearing_received", "settled", "exception"
            ]
          },
          "strategy": { "type": "string", "enum": ["pre_authorization_step_up", "provisional_monitoring"] },
          "challenge": { "$ref": "#/components/schemas/ChallengeBinding" },
          "capReservation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["spendKey", "amountMinor"],
            "properties": {
              "spendKey": { "type": "string" },
              "amountMinor": { "type": "integer", "minimum": 1 }
            }
          }
        }
      },
      "ConfirmationView": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amountMinor", "currency", "merchantId", "paymentTokenId", "trustedDeviceId", "challengeId", "expiresAt"],
        "properties": {
          "amountMinor": { "type": "integer", "minimum": 1 },
          "currency": { "type": "string", "enum": ["USD", "EUR", "GBP", "CAD", "AUD"] },
          "merchantId": { "type": "string" },
          "paymentTokenId": { "type": "string" },
          "trustedDeviceId": { "type": "string" },
          "challengeId": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "Actions": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestProvisioning", "attackProvisioning", "approveProvisioning",
          "revokeDevice", "requestTransaction", "confirmTransaction",
          "expireTransaction", "receiveClearing", "negativeBinding"
        ],
        "properties": {
          "requestProvisioning": { "type": "boolean" },
          "attackProvisioning": { "type": "boolean" },
          "approveProvisioning": { "type": "boolean" },
          "revokeDevice": { "type": "boolean" },
          "requestTransaction": { "type": "boolean" },
          "confirmTransaction": { "type": "boolean" },
          "expireTransaction": { "type": "boolean" },
          "receiveClearing": { "type": "boolean" },
          "negativeBinding": { "type": "boolean" }
        }
      },
      "AuditEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "eventId", "type", "correlationId", "occurredAt", "payload", "previousHash", "hash"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "eventId": { "type": "string" },
          "type": { "type": "string" },
          "correlationId": { "type": "string" },
          "causationId": { "type": "string" },
          "occurredAt": { "type": "string", "format": "date-time" },
          "payload": { "type": "object", "additionalProperties": true },
          "previousHash": { "type": "string" },
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "AuditView": {
        "type": "object",
        "additionalProperties": false,
        "required": ["valid", "events"],
        "properties": {
          "valid": { "type": "boolean" },
          "events": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AuditEvent" }
          }
        }
      },
      "Demonstration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "blocked", "message"],
        "properties": {
          "name": { "type": "string" },
          "blocked": { "type": "boolean" },
          "message": { "type": "string" },
          "auditCopyValid": { "type": "boolean" }
        }
      },
      "LastResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok", "outcome", "code", "action", "message", "at"],
        "oneOf": [
          {
            "type": "object",
            "required": ["ok", "outcome", "code"],
            "properties": {
              "ok": { "const": true },
              "outcome": { "const": "accepted" },
              "code": {
                "enum": [
                  "RESET", "PROVISIONING_REQUESTED", "PROVISIONING_APPROVED",
                  "DEVICE_REVOKED", "TRANSACTION_PENDING",
                  "TRANSACTION_CONFIRMED", "TRANSACTION_EXPIRED_REVERSED",
                  "TRANSACTION_SETTLED"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": ["ok", "outcome", "code"],
            "properties": {
              "ok": { "const": false },
              "outcome": { "const": "warning" },
              "code": { "const": "CLEARING_AFTER_REVERSAL" }
            }
          },
          {
            "type": "object",
            "required": ["ok", "outcome", "code"],
            "properties": {
              "ok": { "const": false },
              "outcome": { "const": "blocked" },
              "code": {
                "not": {
                  "enum": [
                    "RESET", "PROVISIONING_REQUESTED", "PROVISIONING_APPROVED",
                    "DEVICE_REVOKED", "TRANSACTION_PENDING",
                    "TRANSACTION_CONFIRMED", "TRANSACTION_EXPIRED_REVERSED",
                    "TRANSACTION_SETTLED", "CLEARING_AFTER_REVERSAL"
                  ]
                }
              }
            }
          }
        ],
        "properties": {
          "ok": { "type": "boolean" },
          "outcome": { "type": "string", "enum": ["accepted", "blocked", "warning"] },
          "code": { "$ref": "#/components/schemas/ReasonCode" },
          "action": { "type": "string" },
          "message": { "type": "string" },
          "at": { "type": "string", "format": "date-time" }
        }
      },
      "ReasonCode": {
        "type": "string",
        "description": "Closed machine-stable simulator result/rejection vocabulary. Unknown values are contract violations.",
        "enum": [
          "RESET", "PROVISIONING_REQUESTED", "PROVISIONING_APPROVED",
          "DEVICE_REVOKED", "TRANSACTION_PENDING", "TRANSACTION_CONFIRMED",
          "TRANSACTION_EXPIRED_REVERSED", "TRANSACTION_SETTLED",
          "CLEARING_AFTER_REVERSAL", "ATTACK_BLOCKED", "SECURITY_INVARIANT_FAILED",
          "NOT_FOUND", "INVALID_CONTENT_LENGTH", "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE", "BODY_REQUIRED", "MALFORMED_JSON",
          "BODY_NOT_OBJECT", "CROSS_ORIGIN_REJECTED", "UNTRUSTED_ORIGIN",
          "HOST_REQUIRED", "INVALID_ORIGIN", "IDEMPOTENCY_KEY_REQUIRED",
          "IDEMPOTENCY_KEY_INVALID", "IDEMPOTENCY_KEY_TOO_LONG",
          "IDEMPOTENCY_CONFLICT", "PERSISTENCE_CONFLICT",
          "PERSISTENCE_UNAVAILABLE", "PROVISIONING_ALREADY_REQUESTED",
          "PROVISIONING_REQUIRED", "PROVISIONING_NOT_PENDING",
          "DEVICE_ALREADY_REVOKED", "TOKEN_NOT_SPENDABLE",
          "TRANSACTION_ALREADY_EXISTS", "TRANSACTION_REQUIRED",
          "TRANSACTION_NOT_PENDING", "CLEARING_NOT_ALLOWED", "AMOUNT_REQUIRED",
          "AMOUNT_NON_POSITIVE", "AMOUNT_FORMAT_INVALID", "AMOUNT_TOO_LARGE",
          "MERCHANT_REQUIRED", "MERCHANT_INVALID", "AUDIT_EMPTY",
          "UNKNOWN_DEMONSTRATION", "CHALLENGE_BINDING_MISMATCH",
          "CHALLENGE_EXPIRED", "CHALLENGE_TERMINAL", "DEVICE_KEY_MISMATCH",
          "DEVICE_NOT_ACTIVE", "INVALID_STATE_TRANSITION", "CAP_EXCEEDED",
          "DOMAIN_REJECTED", "INTERNAL_ERROR", "RATE_LIMITED",
          "AUTHENTICATION_REQUIRED", "AUTHENTICATION_FAILED",
          "CSRF_INVALID", "SESSION_LIMIT_REACHED", "TENANT_FORBIDDEN",
          "SERVICE_OVERLOADED"
        ]
      },
      "PublicState": {
        "type": "object",
        "additionalProperties": false,
        "required": ["simulator", "notice", "device", "actions", "audit", "lastResult"],
        "properties": {
          "simulator": { "type": "boolean", "const": true },
          "notice": {
            "type": "string",
            "const": "Synthetic reference implementation. No PAN, bank, wallet, processor, or payment rail is connected."
          },
          "device": { "$ref": "#/components/schemas/TrustedDevice" },
          "token": { "$ref": "#/components/schemas/PaymentToken" },
          "provisioning": { "$ref": "#/components/schemas/ProvisioningRequest" },
          "transaction": { "$ref": "#/components/schemas/Transaction" },
          "confirmation": { "$ref": "#/components/schemas/ConfirmationView" },
          "actions": { "$ref": "#/components/schemas/Actions" },
          "audit": { "$ref": "#/components/schemas/AuditView" },
          "demonstration": { "$ref": "#/components/schemas/Demonstration" },
          "lastResult": { "$ref": "#/components/schemas/LastResult" }
        }
      }
    }
  }
}
