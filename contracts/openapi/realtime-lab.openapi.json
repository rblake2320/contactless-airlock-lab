    "/api/transaction/clear": {
      "post": {
        "operationId": "receiveSyntheticClearing",
        "tags": ["simulator"], "security": [{}, { "sessionCookie": [] }], "x-simulator-only": true, "x-maxBodyBytes": 16384,
