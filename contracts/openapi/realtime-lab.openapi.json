{
  "openapi": "3.1.0",
  "info": {
    "title": "Contactless Airlock Realtime Lab API",
    "version": "0.1.0",
    "description": "SIMULATOR ONLY. Exact HTTP contract for the local realtime demonstration. This is not a bank, processor, wallet, TSP, network, or production partner API."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "http://127.0.0.1:8788",
      "description": "Local synthetic-data simulator"
    }
  ],
  "tags": [
    {
      "name": "simulator",
      "description": "Synthetic reference implementation; no payment rail is connected."
    }
  ],
  "x-airlock-access-profiles": {
    "simulator": {
      "description": "Explicit local synthetic mode selected by AIRLOCK_SIMULATOR_MODE=true.",
      "operationSecurity": []
    },
    "authenticated": {
      "description": "Tenant-isolated session mode. OIDC access-token exchange is composed and tested; WebAuthn remains uncomposed.",
      "publicOperationIds": ["getLabHealth"],
      "loginOperationIds": ["loginSession"],
      "loginSecurity": [{ "loginBearer": [] }],
      "loginProviderProfiles": {
        "bootstrap-controlled-demo": "Opaque controlled-demo credential.",
        "oidc": "OIDC JWT access token verified under the configured issuer, audience, algorithm, JWKS, claims, and time policy."
      },
      "sessionSecurity": [{ "sessionCookie": [] }],
      "sessionProtectedOperationIds": [
        "getSession", "logoutSession", "getLabState", "streamLabState",
        "resetLab", "requestSyntheticProvisioning", "attemptPendingTokenSpend",
        "approveSyntheticProvisioning", "revokeSyntheticDevice",
        "requestSyntheticTransaction", "confirmSyntheticTransaction",
        "expireSyntheticTransaction", "receiveSyntheticClearing",
        "demonstrateAuditTamper", "demonstrateBindingAttack"
      ],
      "csrfProtectedOperationIds": [
        "logoutSession", "resetLab", "requestSyntheticProvisioning",
        "attemptPendingTokenSpend", "approveSyntheticProvisioning",
        "revokeSyntheticDevice", "requestSyntheticTransaction",
        "confirmSyntheticTransaction", "expireSyntheticTransaction",
        "receiveSyntheticClearing", "demonstrateAuditTamper",
        "demonstrateBindingAttack"
      ],
      "csrfRequiredHeaders": ["Origin", "X-CSRF-Token"],
      "oidcRuntimeComposition": true,
      "webAuthnRuntimeComposition": false
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getLabHealth",
        "tags": ["simulator"],
        "security": [],
        "x-simulator-only": true,
        "responses": {
          "200": {
            "description": "Lab process health",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/session/login": {
      "post": {
        "operationId": "loginSession",
        "tags": ["simulator"],
        "security": [{ "loginBearer": [] }],
        "x-simulator-only": true,
        "x-maxBodyBytes": 0,
        "parameters": [{ "$ref": "#/components/parameters/Origin" }],
        "responses": {
          "200": {
            "description": "Authenticated bounded session established",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionLogin" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SimpleError" },
          "403": { "$ref": "#/components/responses/SimpleError" },
          "409": { "$ref": "#/components/responses/SimpleError" },
          "429": { "$ref": "#/components/responses/SimpleError" }
        }
      }
    },
    "/api/session": {
      "get": {
        "operationId": "getSession",
        "tags": ["simulator"],
        "security": [{ "sessionCookie": [] }],
        "x-simulator-only": true,
        "responses": {
          "200": {
            "description": "Current authenticated principal",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionCurrent" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SimpleError" },
          "409": { "$ref": "#/components/responses/SimpleError" }
        }
      }
    },
    "/api/session/logout": {
      "post": {
        "operationId": "logoutSession",
        "tags": ["simulator"],
        "security": [{ "sessionCookie": [] }],
        "x-simulator-only": true,
        "x-maxBodyBytes": 0,
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "responses": {
          "200": {
            "description": "Session revoked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["loggedOut"],
                  "properties": { "loggedOut": { "const": true } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SimpleError" },
          "403": { "$ref": "#/components/responses/SimpleError" },
          "409": { "$ref": "#/components/responses/SimpleError" }
        }
      }
    },
    "/api/state": {
      "get": {
        "operationId": "getLabState",
        "tags": ["simulator"],
        "security": [{}, { "sessionCookie": [] }],
        "x-simulator-only": true,
        "responses": {
          "200": { "$ref": "#/components/responses/StateResponse" },
          "401": { "$ref": "#/components/responses/SimpleError" }
        }
      }
    },
    "/api/events": {
      "get": {
        "operationId": "streamLabState",
        "tags": ["simulator"],
        "security": [{}, { "sessionCookie": [] }],
        "x-simulator-only": true,
        "responses": {
          "200": {
            "description": "Server-sent state events and 15-second comment heartbeats",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string", "const": "no-store" }
              }
            },
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Each state event is `event: state` followed by one JSON PublicState data line."
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SimpleError" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/reset": {
      "post": {
        "operationId": "resetLab",
        "tags": ["simulator"],
        "security": [{}, { "sessionCookie": [] }],
        "x-simulator-only": true,
        "x-maxBodyBytes": 16384,
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/SecFetchSite" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/OptionalObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/StateResponse" }, "400": { "$ref": "#/components/responses/SimpleError" },
          "401": { "$ref": "#/components/responses/SimpleError" }, "403": { "$ref": "#/components/responses/SimpleError" }, "409": { "$ref": "#/components/responses/ConflictError" },
          "413": { "$ref": "#/components/responses/SimpleError" }, "415": { "$ref": "#/components/responses/SimpleError" },
          "428": { "$ref": "#/components/responses/SimpleError" }, "431": { "$ref": "#/components/responses/SimpleError" },
          "429": { "$ref": "#/components/responses/RateLimited" }, "503": { "$ref": "#/components/responses/StateError" }
        }
      }
    },
    "/api/provision/request": {
