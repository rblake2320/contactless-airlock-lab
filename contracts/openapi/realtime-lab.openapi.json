          "413": { "$ref": "#/components/responses/SimpleError" }, "415": { "$ref": "#/components/responses/SimpleError" },
          "428": { "$ref": "#/components/responses/SimpleError" }, "431": { "$ref": "#/components/responses/SimpleError" },
          "429": { "$ref": "#/components/responses/RateLimited" }, "503": { "$ref": "#/components/responses/StateError" }
